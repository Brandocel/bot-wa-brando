// Esquema completo (Fases 1–7). Las tablas de ventas se crean desde ya
// aunque el agente todavía no las use: migrar en frío es gratis, migrar
// con datos en producción no.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Núcleo de conversación ───────────────────────────────────────────────

enum Role {
  OWNER // solo yo, resuelto contra OWNER_WA_ID
  PROSPECT // desconocido que escribió primero
  CUSTOMER // ya cerró conmigo
  BLOCKED
}

enum ConvState {
  IDLE
  COLLECTING_INFO
  AWAITING_CONFIRMATION
  EXECUTING
}

enum Direction {
  IN
  OUT
}

enum MessageKind {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  TOOL_RESULT
  UNSUPPORTED
}

model Contact {
  id          String   @id @default(cuid())
  waId        String   @unique // "5215512345678@c.us"
  displayName String?
  role        Role     @default(PROSPECT)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]
  memoryFacts   MemoryFact[]
  reminders     Reminder[]
  lead          Lead?

  @@index([role])
}

model Conversation {
  id        String    @id @default(cuid())
  chatId    String    @unique
  contactId String
  state     ConvState @default(IDLE)
  context   Json      @default("{}") // slots de la máquina de estados
  expiresAt DateTime? // TTL: al vencer, vuelve a IDLE
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([contactId])
}

model Message {
  // El id ES el messageId de WhatsApp. Esa es toda la idempotencia:
  // si open-wa reentrega, el insert choca con la PK y lo descartamos.
  id             String      @id
  conversationId String
  direction      Direction
  kind           MessageKind @default(TEXT)
  body           String      @db.Text
  raw            Json? // payload original, para depurar el ACL
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Envío confiable (patrón Outbox) ──────────────────────────────────────

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model OutboxMessage {
  id        String       @id @default(cuid())
  chatId    String
  payload   Json // { kind: "text", text: "..." }
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

// ─── Ventas ───────────────────────────────────────────────────────────────

enum LeadStage {
  NUEVO
  DIAGNOSTICO
  CALIFICANDO
  PROPUESTA_VERBAL
  HANDOFF
  GANADO
  PERDIDO
}

model Lead {
  id        String    @id @default(cuid())
  contactId String    @unique
  stage     LeadStage @default(NUEVO)

  // Slots de calificación. El agente NO avanza de etapa hasta llenarlos:
  // { problema, impacto, presupuesto_aprox, decide_quien, plazo }
  qualification Json @default("{}")

  source        String? // bio, web, referido de <quién>
  ownerTakeover Boolean @default(false) // true = yo al volante, bot callado
  lostReason    String?

  nextFollowUp DateTime? // lo que dispara el cron de seguimiento
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contact Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  handoff Handoff?

  @@index([stage, nextFollowUp])
}

// Rangos publicados. El LLM SOLO puede citar de aquí; jamás una cifra propia.
model ServicePackage {
  id          String  @id @default(cuid())
  name        String
  description String  @db.Text
  scopeNotes  String  @db.Text // qué SÍ y qué NO incluye
  priceMin    Decimal @db.Decimal(12, 2)
  priceMax    Decimal @db.Decimal(12, 2)
  currency    String  @default("MXN")
  active      Boolean @default(true)
}

// El entregable real del agente de ventas.
model Handoff {
  id     String @id @default(cuid())
  leadId String @unique

  // { problema, impacto, presupuesto, plazo, objeciones[], resumen }
  brief Json

  reason      String // calificado | pidio_humano | atorado | molesto
  deliveredAt DateTime @default(now())
  outcome     String? // lo lleno yo: ganado | perdido | <motivo>

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// Editable sin redeploy: objeción -> respuesta aprobada por mí.
model ObjectionPlaybook {
  id       String  @id @default(cuid())
  trigger  String // "está muy caro"
  response String  @db.Text
  active   Boolean @default(true)
}

// ─── Asistente personal ───────────────────────────────────────────────────

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

model Reminder {
  id        String         @id @default(cuid())
  contactId String
  text      String         @db.Text
  dueAt     DateTime
  status    ReminderStatus @default(PENDING)
  createdAt DateTime       @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
}

model MemoryFact {
  id        String   @id @default(cuid())
  contactId String
  fact      String   @db.Text
  source    String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

// ─── Operación ────────────────────────────────────────────────────────────

// Kill switch y flags, editables desde WhatsApp con /pausa y /reanuda.
model SystemFlag {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
