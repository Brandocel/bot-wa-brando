// Esquema completo (Fases 1–7). Las tablas de ventas se crean desde ya
// aunque el agente todavía no las use: migrar en frío es gratis, migrar
// con datos en producción no.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Núcleo de conversación ───────────────────────────────────────────────

enum Role {
  OWNER // solo yo, resuelto contra OWNER_WA_ID
  PROSPECT // desconocido que escribió primero
  CUSTOMER // ya cerró conmigo
  BLOCKED
}

/// De quién se espera el siguiente mensaje.
enum Awaiting {
  NADIE // nada pendiente
  BOT // llegó algo y todavía no se responde
  CLIENTE // se le preguntó y no ha contestado
  AGENTE // escalado: espera a una persona
}

enum ConvState {
  IDLE
  COLLECTING_INFO
  AWAITING_CONFIRMATION
  EXECUTING
}

enum Direction {
  IN
  OUT
}

enum MessageKind {
  TEXT
  AUDIO
  IMAGE
  DOCUMENT
  TOOL_RESULT
  UNSUPPORTED
}

model Contact {
  id          String   @id @default(cuid())
  waId        String   @unique // "5215512345678@c.us"
  displayName String?
  role        Role     @default(PROSPECT)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conversations Conversation[]
  memoryFacts   MemoryFact[]
  reminders     Reminder[]
  lead          Lead?
  memberships   Membership[]
  tickets       Ticket[]

  @@index([role])
}

model Conversation {
  id        String    @id @default(cuid())
  chatId    String    @unique
  contactId String
  state     ConvState @default(IDLE)
  context   Json      @default("{}") // slots de la máquina de estados
  expiresAt DateTime? // TTL: al vencer, vuelve a IDLE
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// De qué trata el hilo. Se hereda del último ticket con categoría
  /// resuelta, para poder filtrar la bandeja por tema sin abrir cada
  /// conversación una por una.
  topic DocCategory?

  /// De quién es el turno. Es la bandera que ordena la bandeja: lo que
  /// espera al cliente no corre prisa, lo que nos espera a nosotros sí.
  awaiting Awaiting @default(NADIE)

  /// Cuándo el bot marcó como leído el último entrante. null = nunca se
  /// acusó recibo, que es lo que el cliente percibe como "ni me leyeron".
  seenAt DateTime?

  lastInboundAt  DateTime?
  lastOutboundAt DateTime?

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]
  tickets  Ticket[]

  @@index([contactId])
  // La consulta de la bandeja: "qué está esperando por nosotros y desde
  // cuándo". Sin este índice es un barrido completo en cada refresco.
  @@index([awaiting, lastInboundAt])
}

model Message {
  // El id ES el messageId de WhatsApp. Esa es toda la idempotencia:
  // si open-wa reentrega, el insert choca con la PK y lo descartamos.
  id             String      @id
  conversationId String
  direction      Direction
  kind           MessageKind @default(TEXT)
  body           String      @db.Text
  raw            Json? // payload original, para depurar el ACL
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Envío confiable (patrón Outbox) ──────────────────────────────────────

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model OutboxMessage {
  id        String       @id @default(cuid())
  chatId    String
  payload   Json // { kind: "text", text: "..." }
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

// ─── Ventas ───────────────────────────────────────────────────────────────

enum LeadStage {
  NUEVO
  DIAGNOSTICO
  CALIFICANDO
  PROPUESTA_VERBAL
  HANDOFF
  GANADO
  PERDIDO
}

model Lead {
  id        String    @id @default(cuid())
  contactId String    @unique
  stage     LeadStage @default(NUEVO)

  // Slots de calificación. El agente NO avanza de etapa hasta llenarlos:
  // { problema, impacto, presupuesto_aprox, decide_quien, plazo }
  qualification Json @default("{}")

  source        String? // bio, web, referido de <quién>
  ownerTakeover Boolean @default(false) // true = yo al volante, bot callado
  lostReason    String?

  nextFollowUp DateTime? // lo que dispara el cron de seguimiento
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contact Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  handoff Handoff?

  @@index([stage, nextFollowUp])
}

// Rangos publicados. El LLM SOLO puede citar de aquí; jamás una cifra propia.
model ServicePackage {
  id          String  @id @default(cuid())
  name        String
  description String  @db.Text
  scopeNotes  String  @db.Text // qué SÍ y qué NO incluye
  priceMin    Decimal @db.Decimal(12, 2)
  priceMax    Decimal @db.Decimal(12, 2)
  currency    String  @default("MXN")
  active      Boolean @default(true)
}

// El entregable real del agente de ventas.
model Handoff {
  id     String @id @default(cuid())
  leadId String @unique

  // { problema, impacto, presupuesto, plazo, objeciones[], resumen }
  brief Json

  reason      String // calificado | pidio_humano | atorado | molesto
  deliveredAt DateTime @default(now())
  outcome     String? // lo lleno yo: ganado | perdido | <motivo>

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// Editable sin redeploy: objeción -> respuesta aprobada por mí.
model ObjectionPlaybook {
  id       String  @id @default(cuid())
  trigger  String // "está muy caro"
  response String  @db.Text
  active   Boolean @default(true)
}

// ─── Asistente personal ───────────────────────────────────────────────────

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

model Reminder {
  id        String         @id @default(cuid())
  contactId String
  text      String         @db.Text
  dueAt     DateTime
  status    ReminderStatus @default(PENDING)
  createdAt DateTime       @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
}

model MemoryFact {
  id        String   @id @default(cuid())
  contactId String
  fact      String   @db.Text
  source    String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
}

// ─── Operación ────────────────────────────────────────────────────────────

// Kill switch y flags, editables desde WhatsApp con /pausa y /reanuda.
model SystemFlag {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Soporte documental: multi-empresa ────────────────────────────────────
// Ver docs/ARQUITECTURA-SOPORTE.md. Regla que manda sobre todo lo de abajo:
// el permiso se resuelve en SQL contra el waId ANTES de que el LLM vea nada.

model Organization {
  id            String  @id @default(cuid())
  name          String
  taxId         String? @unique // RFC: la llave real del negocio
  driveFolderId String  @unique // carpeta raíz en Drive
  active        Boolean @default(true)

  /// Cuando se recorrio su carpeta por completo. null = pendiente de
  /// barrido, que es el estado de una empresa nueva o de una que acaba
  /// de cambiar de carpeta.
  lastScanAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  documents   Document[]
  tickets     Ticket[]
}

enum MemberRole {
  VIEWER // consulta solo lo que su AccessGrant permita
  MANAGER // consulta todo lo de su organización
  ADMIN // además puede autorizar a otros números
}

/// Un número puede pertenecer a varias organizaciones. La membresía —no el
/// contacto— es lo que otorga acceso, y caduca: los números cambian de dueño.
model Membership {
  id             String     @id @default(cuid())
  contactId      String
  organizationId String
  role           MemberRole @default(VIEWER)

  /// null = nunca entregar documento sensible. Un número de WhatsApp no es
  /// una credencial: se reasigna, se clona, se pierde el teléfono.
  verifiedAt DateTime?

  validFrom  DateTime  @default(now())
  validUntil DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grants       AccessGrant[]

  @@unique([contactId, organizationId])
  @@index([organizationId, revokedAt])
}

enum DocCategory {
  FACTURA
  CONTRATO
  COTIZACION
  REPORTE
  POLIZA
  OTRO
}

/// Permiso explícito y acotado. Sin grant aplicable, denegado.
/// periodFrom/periodTo acotan por el periodo DEL DOCUMENTO, no por su fecha
/// de subida: "este proveedor solo ve sus facturas de 2026 en adelante".
model AccessGrant {
  id           String      @id @default(cuid())
  membershipId String
  category     DocCategory
  periodFrom   DateTime?
  periodTo     DateTime?
  grantedBy    String // waId de quien autorizó, para auditoría
  createdAt    DateTime    @default(now())
  revokedAt    DateTime?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, category])
}

// ─── Índice de Drive ──────────────────────────────────────────────────────

enum DocStatus {
  INDEXED // metadatos verificados: entregable
  QUARANTINE // no se pudo determinar organización o periodo: invisible
  DELETED // borrado en Drive; la fila se conserva para la auditoría
}

model Document {
  id             String      @id @default(cuid())
  organizationId String
  driveFileId    String      @unique
  driveVersion   String // headRevisionId: así se detecta un cambio
  name           String
  mimeType       String
  sizeBytes      Int
  category       DocCategory
  period         DateTime? // primer día del mes al que pertenece el documento
  folio          String?
  status         DocStatus   @default(QUARANTINE)
  extractedText  String?     @db.Text
  indexedAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, category, period])
  @@index([status])
}

/// Cursor de la Drive Changes API. Una sola fila ("singleton"). Sin esto,
/// cada sincronización sería un barrido completo del Drive.
model DriveSyncState {
  id         String   @id @default("singleton")
  pageToken  String
  lastSyncAt DateTime @updatedAt
  lastError  String?
}

// ─── Tickets ──────────────────────────────────────────────────────────────

enum TicketState {
  ABIERTO
  EN_REVISION
  CERRADO
}

enum TicketPriority {
  BAJA
  MEDIA
  ALTA
}

model Ticket {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement()) // el folio humano
  conversationId String
  organizationId String?
  contactId      String
  subject        String
  state          TicketState    @default(ABIERTO)
  priority       TicketPriority @default(MEDIA)
  level          Int            @default(0) // 0 bot · 1 agente · 2 supervisor
  assignedToWaId String?
  slots          Json           @default("{}")
  slaDueAt       DateTime?
  closedAt       DateTime?
  closeReason    String? // resuelto | sin_permiso | no_encontrado | ttl | usuario
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  events       TicketEvent[]

  @@index([state, priority, slaDueAt])
  @@index([conversationId, state])
}

/// Bitácora append-only del ticket: aquí nunca se hace UPDATE. El campo
/// `state` del ticket existe por comodidad de consulta; la verdad está aquí.
model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  type      String // creado | estado | prioridad | escalado | asignado | nota | entrega
  actor     String // "bot" o el waId del humano
  data      Json
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ─── Auditoría de acceso ──────────────────────────────────────────────────

/// Toda decisión de acceso queda escrita, permitida o no. Con facturas de por
/// medio esto deja de ser higiene y pasa a ser requisito.
model AccessAudit {
  id         String   @id @default(cuid())
  ticketId   String?
  waId       String
  query      String   @db.Text
  documentId String?
  decision   String // ALLOW | DENY_NO_MEMBERSHIP | DENY_NO_GRANT | DENY_PERIOD | DENY_UNVERIFIED | NOT_FOUND
  decidedBy  String // nombre de la regla que decidió
  createdAt  DateTime @default(now())

  @@index([waId, createdAt])
  @@index([decision, createdAt])
}

// ─── Panel de operación ───────────────────────────────────────────────────
// Cuentas propias del panel, separadas de Contact a propósito: un operador
// no es un contacto de WhatsApp, y mezclar las dos cosas haría que dar de
// alta a alguien en el panel le diera permisos sobre documentos.

enum PanelRole {
  ADMIN // ve todo y, en la siguiente etapa, edita
  AGENTE // ve tickets y conversaciones, no toca permisos
}

model PanelUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String // scrypt: sal y hash en la misma cadena
  role         PanelRole @default(AGENTE)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions PanelSession[]
}

/// Sesiones en base y no un JWT: así una cuenta se puede revocar de verdad.
/// Un JWT firmado sigue siendo válido hasta que caduca, aunque desactives
/// al usuario — y aquí del otro lado hay facturas.
model PanelSession {
  id        String   @id @default(cuid())
  /// Hash del token, no el token. Si alguien lee esta tabla, no se lleva
  /// sesiones utilizables.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user PanelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
