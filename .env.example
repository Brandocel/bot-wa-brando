# Copia a .env y llena. .env está en .gitignore — que siga así.

# ── Compartido ────────────────────────────────────────────────────────────
# Clave que autentica gateway <-> core en ambas direcciones.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_API_KEY=cambiame

# ── wa-gateway ────────────────────────────────────────────────────────────
GATEWAY_PORT=10000
WA_SESSION_ID=brando
WA_SESSION_PATH=./data/session
# A dónde reenvía los mensajes entrantes. En Render lo inyecta render.yaml.
CORE_WEBHOOK_URL=http://localhost:3000
# Solo en Docker/Render. En local déjalo vacío y open-wa baja su propio Chromium.
PUPPETEER_EXECUTABLE_PATH=

# ── agent-core ────────────────────────────────────────────────────────────
CORE_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/botwa?schema=public
# A dónde le habla el core para enviar mensajes.
GATEWAY_URL=http://localhost:10000

# Tu número en formato WhatsApp. OJO: es el que decide quién es OWNER.
# Formato: <lada país><número>@c.us  — ej. 5215512345678@c.us
OWNER_WA_ID=

# Fase 3 en adelante.
ANTHROPIC_API_KEY=

# ── Google Drive (módulo de soporte documental) ───────────────────────────
# El JSON COMPLETO de la cuenta de servicio, en una sola línea.
# Google Cloud Console → IAM → Cuentas de servicio → Claves → Crear (JSON).
# Vacío = la sincronización queda apagada y el resto del bot sigue igual.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cada cuánto revisa Drive. 10 min por defecto.
DRIVE_SYNC_INTERVAL_MS=600000

# Tope de tamaño para entregar por WhatsApp. Arriba de esto se escala.
MAX_DELIVERABLE_BYTES=15728640
