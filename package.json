{
  "name": "bot-wa-brando",
  "private": true,
  "version": "0.1.0",
  "description": "Jarvis: asistente de WhatsApp que entrega documentos de cada empresa a quien tiene permiso",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:gateway": "npm run dev --workspace=wa-gateway",
    "dev:core": "npm run dev --workspace=agent-core",
    "conector": "node apps/pc-connector/conector.cjs",
    "build:conector": "node apps/pc-connector/build-exe.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc -b --pretty",
    "test:conversational": "tsx --tsconfig apps/agent-core/tsconfig.json --test apps/agent-core/src/application/support/query-parser.test.ts apps/agent-core/src/application/support/slot-extractor.service.test.ts apps/agent-core/src/application/support/support.strategy.test.ts apps/agent-core/src/application/pipeline/filters/rate-limit.filter.test.ts apps/agent-core/src/application/support/lineas.test.ts apps/agent-core/src/application/support/support.mixed-intents.test.ts apps/agent-core/src/application/sales/sales.test.ts",
    "test:documentos": "tsx --tsconfig apps/agent-core/tsconfig.json --test apps/agent-core/src/application/support/document-classification.test.ts",
    "smoke-test":"node scripts/smoke-test.js",
    "seed": "tsx --tsconfig tsconfig.base.json prisma/seed.ts",
    "prisma:deploy": "prisma migrate deploy",
    "verify:access": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-access.ts",
    "verify:parser": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-parser.ts",
    "verify:drive": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-drive.ts",
    "verify:strategy": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-strategy.ts",
    "panel:user": "tsx --tsconfig tsconfig.base.json scripts/dev/create-panel-user.ts",
    "ventas:catalogo": "tsx --tsconfig tsconfig.base.json scripts/ventas/cargar-catalogo.ts",
    "verify:phone": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-phone.ts",
    "verify:delivery": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-delivery.ts",
    "verify:entrega": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-entrega-real.ts",
    "verify:clasificador": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-clasificador.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "postject": "^1.0.0-alpha.6",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "prisma": {
    "seed": "tsx --tsconfig tsconfig.base.json prisma/seed.ts"
  }
}
