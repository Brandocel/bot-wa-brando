{
  "name": "bot-wa-brando",
  "private": true,
  "version": "0.1.0",
  "description": "Agente de WhatsApp: vendedor consultivo + asistente personal",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:gateway": "npm run dev --workspace=wa-gateway",
    "dev:core": "npm run dev --workspace=agent-core",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc -b --pretty",
    "smoke-test": "node scripts/smoke-test.js",
    "seed": "tsx --tsconfig tsconfig.base.json prisma/seed.ts",
    "prisma:deploy": "prisma migrate deploy",
    "verify:access": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-access.ts",
    "verify:parser": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-parser.ts",
    "verify:drive": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-drive.ts",
    "verify:strategy": "tsx --tsconfig tsconfig.base.json scripts/dev/verify-strategy.ts",
    "panel:user": "tsx --tsconfig tsconfig.base.json scripts/dev/create-panel-user.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  },
  "prisma": {
    "seed": "tsx --tsconfig tsconfig.base.json prisma/seed.ts"
  }
}
